                "type": "string",
                "description": "The ID of the verification to check, such as one returned by prepare_verification"
              },
              "code": {
                "type": "string",
                "description": "The verification code that was sent to the phone number"
              }
            },
            "required": ["verification_id", "code"],
            "description": "JSON request body."
          },
          "phone_number_id": {
            "type": "string",
            "description": "The ID of the phone number whose code is being verified"
          }
        },
        "required": ["phone_number_id", "body"],
        "additionalProperties": false
      }
    }
